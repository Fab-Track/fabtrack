{
  "name": "Customer",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization ID for multi-tenant isolation"
    },
    "name": {
      "type": "string",
      "description": "Customer display name (full name or company name)"
    },
    "first_name": {
      "type": "string",
      "description": "First name"
    },
    "last_name": {
      "type": "string",
      "description": "Last name"
    },
    "display_name": {
      "type": "string",
      "description": "Display name chosen from full name or company name"
    },
    "type": {
      "type": "string",
      "enum": [
        "Homeowner",
        "General Contractor",
        "Builder / Developer",
        "Commercial Business",
        "Subcontractor",
        "Other"
      ],
      "description": "Customer type"
    },
    "company": {
      "type": "string",
      "description": "Company name (for GCs)"
    },
    "job_code": {
      "type": "string",
      "enum": [
        "Residential",
        "Commercial"
      ],
      "description": "Job classification: Residential or Commercial"
    },
    "lead_source": {
      "type": "string",
      "description": "How the customer found us (Facebook, Instagram, Internet Search, Referral, etc.)"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "address": {
      "type": "string",
      "description": "Primary address (composed from street, city, state, zip)"
    },
    "address_street": {
      "type": "string",
      "description": "Street address line"
    },
    "address_city": {
      "type": "string",
      "description": "City"
    },
    "address_state": {
      "type": "string",
      "description": "State"
    },
    "address_zip": {
      "type": "string",
      "description": "ZIP code"
    },
    "address_lat": {
      "type": "number",
      "description": "Latitude of the primary address (from Google Places)"
    },
    "address_lng": {
      "type": "number",
      "description": "Longitude of the primary address (from Google Places)"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes"
    },
    "qbo_customer_id": {
      "type": "string",
      "description": "Linked QuickBooks Online Customer Id (resolved by name on first invoice sync)"
    },
    "contacts": {
      "type": "array",
      "description": "Directory of contacts associated with this customer. Every contact lives here; jobs reference them by id via site_contact_id / approver_contact_id / bill_to_contact_id.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique id for this contact entry"
          },
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "description": "Role / title (e.g. Super, PM, HOA rep)"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "Legacy role field \u2014 kept for backward compat; title is the new field"
          },
          "is_primary": {
            "type": "boolean",
            "default": false,
            "description": "Whether this is the customer's primary contact"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "locations": {
      "type": "array",
      "description": "Directory of locations associated with this customer (job sites, service addresses, etc.). Jobs reference them by id via location_id.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique id for this location entry"
          },
          "label": {
            "type": "string",
            "description": "Display name for this location (e.g. Main Office, Job Site)"
          },
          "street": {
            "type": "string",
            "description": "Street address line"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "zip": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "description": "Latitude (from Google Places)"
          },
          "lng": {
            "type": "number",
            "description": "Longitude (from Google Places)"
          },
          "address": {
            "type": "string",
            "description": "Full composed address \u2014 kept for backward compat"
          },
          "display_name": {
            "type": "string",
            "description": "Legacy display name \u2014 kept for backward compat; label is the new field"
          },
          "job_address": {
            "type": "string",
            "description": "Specific job address if different from the location address \u2014 kept for backward compat"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "job_contact_name": {
      "type": "string",
      "description": "Legacy flat field \u2014 migrated into contacts[]. Hidden from UI."
    },
    "job_contact_email": {
      "type": "string",
      "description": "Legacy flat field \u2014 migrated into contacts[]. Hidden from UI."
    },
    "job_contact_phone": {
      "type": "string",
      "description": "Legacy flat field \u2014 migrated into contacts[]. Hidden from UI."
    },
    "billing_contact_name": {
      "type": "string",
      "description": "Legacy flat field \u2014 migrated into contacts[]. Hidden from UI."
    },
    "billing_contact_email": {
      "type": "string",
      "description": "Legacy flat field \u2014 migrated into contacts[]. Hidden from UI."
    },
    "billing_contact_phone": {
      "type": "string",
      "description": "Legacy flat field \u2014 migrated into contacts[]. Hidden from UI."
    },
    "billing_contact_address": {
      "type": "string",
      "description": "Legacy flat field \u2014 hidden from UI."
    },
    "billing_same_as_job": {
      "type": "boolean",
      "default": true,
      "description": "Legacy flag \u2014 hidden from UI."
    },
    "billing_same_as_primary": {
      "type": "boolean",
      "default": false,
      "description": "Legacy flag \u2014 hidden from UI."
    },
    "payment_terms": {
      "type": "string",
      "enum": [
        "Net 15",
        "Net 30",
        "Net 45",
        "Custom"
      ],
      "description": "Billing terms for this customer's invoices"
    },
    "payment_terms_custom_days": {
      "type": "number",
      "description": "Custom number of days when payment_terms is 'Custom'"
    },
    "billing_deadline_date": {
      "type": "string",
      "format": "date",
      "description": "Deadline date for submitting billing for this customer"
    },
    "tax_exempt": {
      "type": "boolean",
      "default": false,
      "description": "Whether this customer is tax-exempt (builders/designers with resale certificates)"
    },
    "resale_certificate_uri": {
      "type": "string",
      "description": "Private file URI of the customer's resale certificate (stored privately)"
    },
    "coi_required": {
      "type": "boolean",
      "default": false,
      "description": "Whether a Certificate of Insurance is required for this customer"
    },
    "coi_file_uri": {
      "type": "string",
      "description": "Private file URI of the customer's COI document (stored privately)"
    },
    "coi_expiration": {
      "type": "string",
      "format": "date",
      "description": "Expiration date of the COI on file"
    },
    "w9_required": {
      "type": "boolean",
      "default": false,
      "description": "Whether a W-9 is required for this customer"
    },
    "preferred_contact_method": {
      "type": "string",
      "enum": [
        "Call",
        "Text",
        "Email"
      ],
      "description": "Customer's preferred method of contact"
    },
    "pricing_tier": {
      "type": "string",
      "enum": [
        "Standard",
        "Builder",
        "Designer",
        "Preferred"
      ],
      "description": "Pricing tier for this customer (Standard / Builder / Designer / Preferred)"
    }
  },
  "required": [
    "name",
    "organization_id"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}