{
  "name": "MaterialPriceList",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization ID for multi-tenant isolation"
    },
    "name": {
      "type": "string",
      "description": "Material name / description"
    },
    "category": {
      "type": "string",
      "default": "Other",
      "description": "Shape / material category. Org can add new categories freely."
    },
    "component_type": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "Other"
      ],
      "description": "Which railing slots this item can serve as (Used as). Free-form strings."
    },
    "stock_length_ft": {
      "type": "number",
      "default": 0,
      "description": "Length a stick is ordered in, in feet."
    },
    "cost_per_stick": {
      "type": "number",
      "default": 0,
      "description": "Purchase cost per stick in USD."
    },
    "weight_per_stick": {
      "type": "number",
      "default": 0,
      "description": "Total weight per stick in pounds (legacy)."
    },
    "weight_per_ft": {
      "type": "number",
      "default": 0,
      "description": "Weight in pounds per linear foot. Used when cost_method = weight."
    },
    "price_per_lb_override": {
      "type": "number",
      "description": "Price per pound. Used when cost_method = weight."
    },
    "cost_per_foot": {
      "type": "number",
      "default": 0,
      "description": "Calculated by cost_method: linear_foot = cost_per_stick / stock_length_ft (else typed value); weight = weight_per_ft x price_per_lb_override. Read by the takeoff."
    },
    "cost_method": {
      "type": "string",
      "enum": [
        "linear_foot",
        "weight",
        "unit"
      ],
      "default": "linear_foot",
      "description": "How this item is costed"
    },
    "unit": {
      "type": "string",
      "description": "Unit label when cost_method = unit, e.g. EA, Sheet, SF"
    },
    "cost_per_unit": {
      "type": "number",
      "description": "Cost per unit when cost_method = unit"
    },
    "cost_code_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CostCode ids"
    },
    "cost_type": {
      "type": "string",
      "enum": [
        "Materials",
        "Labor",
        "Subcontractor",
        "Equipment",
        "Other"
      ],
      "default": "Materials"
    },
    "supplier": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "unit_price": {
      "type": "number",
      "description": "Optional unit price"
    },
    "taxable": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "needs_review": {
      "type": "boolean",
      "default": false,
      "description": "Manual flag shown as Needs review"
    }
  },
  "required": [
    "name",
    "organization_id"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}