{
  "name": "MaterialPriceList",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization ID for multi-tenant isolation"
    },
    "name": {
      "type": "string",
      "description": "Material name / description"
    },
    "category": {
      "type": "string",
      "default": "Other",
      "description": "Material category \u2014 used to group materials in Settings. Org can add new categories freely."
    },
    "component_type": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "Other"
      ],
      "description": "Which part(s) of a railing this material can serve as (multi-select, display-only spec; pricing is handled by the Service Catalog cost model). Values are free-form strings \u2014 defaults come from the shared DEFAULT_COMPONENT_TYPES constant; orgs can add their own via the '+ Add new use' option."
    },
    "cost_per_foot": {
      "type": "number",
      "description": "Cost per linear foot in USD (legacy reference only \u2014 not used for pricing)",
      "default": 0
    }
  },
  "required": [
    "name",
    "organization_id"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}