{
  "name": "CatalogCategory",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization ID for multi-tenant isolation"
    },
    "name": {
      "type": "string",
      "description": "Category name; unique per organization"
    },
    "pricing_unit": {
      "type": "string",
      "description": "Display label for the pricing unit, e.g. \"per LF\", \"per tread\", \"lump sum\""
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_railing": {
      "type": "boolean",
      "default": false,
      "description": "If true, this category carries railing defaults that railing takeoff parameters fall back to"
    },
    "is_fixed_price": {
      "type": "boolean",
      "default": false,
      "description": "If true, items in this category are add-ons with a fixed price (e.g. travel, demo)"
    },
    "post_spacing_in": {
      "type": "number",
      "default": 72,
      "description": "Railing default: spacing between posts in inches."
    },
    "post_width_in": {
      "type": "number",
      "default": 1.5,
      "description": "Railing default: post width in inches."
    },
    "picket_clear_gap_in": {
      "type": "number",
      "default": 4,
      "description": "Railing default: clear gap between pickets in inches."
    },
    "picket_width_in": {
      "type": "number",
      "default": 0.5,
      "description": "Railing default: individual picket width in inches."
    },
    "rail_runs": {
      "type": "number",
      "default": 2,
      "description": "Railing default: number of horizontal rail runs (top + bottom rails). Integer."
    }
  },
  "required": [
    "organization_id",
    "name"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}