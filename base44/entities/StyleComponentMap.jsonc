{
  "name": "StyleComponentMap",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization ID for multi-tenant isolation"
    },
    "style_name": {
      "type": "string",
      "description": "Railing style name (links to RailingStyleLibrary.style_name). Kept on existing records for backward read compatibility; new records created from the Service Catalog use service_catalog_id instead."
    },
    "service_catalog_id": {
      "type": "string",
      "description": "Service Catalog item ID this component map belongs to. New records are keyed by this field going forward."
    },
    "components": {
      "type": "array",
      "description": "Ordered list of component materials that make up this railing style",
      "items": {
        "type": "object",
        "properties": {
          "component_label": {
            "type": "string",
            "description": "Slot/role this material fills (e.g. Top Rail, Bottom Rail, Posts, Pickets)"
          },
          "material_id": {
            "type": "string",
            "description": "Reference to MaterialPriceList record"
          },
          "material_name": {
            "type": "string",
            "description": "Denormalized material name for display"
          }
        }
      }
    }
  },
  "required": [
    "organization_id"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}