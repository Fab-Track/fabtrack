{
  "name": "AssistantKnowledge",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization ID for multi-tenant isolation"
    },
    "title": {
      "type": "string",
      "description": "Short label for this piece of company knowledge"
    },
    "content": {
      "type": "string",
      "description": "The fact, rate, process or estimating rule, written out in full"
    },
    "category": {
      "type": "string",
      "enum": [
        "Pricing",
        "Labor",
        "Materials",
        "Process",
        "Customers",
        "Other"
      ],
      "default": "Other",
      "enumColors": [
        "blue",
        "purple",
        "green",
        "yellow",
        "pink",
        "gray"
      ],
      "description": "Grouping used when the assistant recalls this knowledge"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Inactive entries are ignored when estimating"
    },
    "source": {
      "type": "string",
      "enum": [
        "conversation",
        "manual"
      ],
      "default": "conversation"
    },
    "created_by_id": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "title",
    "content"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}