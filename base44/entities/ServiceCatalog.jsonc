{
  "name": "ServiceCatalog",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization ID for multi-tenant isolation"
    },
    "name": {
      "type": "string",
      "description": "Service name"
    },
    "category": {
      "type": "string",
      "description": "Category text (kept for backward compat; category_id is the link)"
    },
    "category_id": {
      "type": "string",
      "description": "Reference to the CatalogCategory record this item belongs to"
    },
    "unit": {
      "type": "string",
      "default": "ls"
    },
    "default_unit_price": {
      "type": "number",
      "default": 0,
      "description": "Legacy default price \u2014 kept for backward compat; cost model is the new source of truth"
    },
    "default_description": {
      "type": "string",
      "description": "Default line item description shown on invoice"
    },
    "photo_url": {
      "type": "string",
      "description": "URL of the uploaded photo for this service item"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "qbo_item_id": {
      "type": "string",
      "description": "Mapped QuickBooks Online Item (Product/Service) Id \u2014 required before invoices using this service can sync to QBO"
    },
    "qbo_item_name": {
      "type": "string",
      "description": "Denormalized QuickBooks Item name for display in the mapping table"
    },
    "is_railing": {
      "type": "boolean",
      "default": false,
      "description": "If true, volume discount tiers are applied based on lnft quantity"
    },
    "style_id": {
      "type": "string",
      "description": "Legacy reference to RailingStyleLibrary. Kept for backward compat but no longer read by the app."
    },
    "post_spacing_in": {
      "type": "number",
      "description": "Railing takeoff override: spacing between posts in inches. Null = use category default."
    },
    "post_width_in": {
      "type": "number",
      "description": "Railing takeoff override: post width in inches. Null = use category default."
    },
    "picket_clear_gap_in": {
      "type": "number",
      "description": "Railing takeoff override: clear gap between pickets in inches. Null = use category default."
    },
    "picket_width_in": {
      "type": "number",
      "description": "Railing takeoff override: individual picket width in inches. Null = use category default."
    },
    "rail_runs": {
      "type": "number",
      "description": "Railing takeoff override: number of horizontal rail runs (top + bottom rails). Null = use category default."
    },
    "components": {
      "type": "array",
      "description": "Ordered component lines for this item. Railing slots (Top Rail, Bottom Rail, Post, Picket) use the railing takeoff; 'Other' lines are counted from qty_per_unit, fixed_qty and waste_pct.",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string",
            "enum": [
              "Top Rail",
              "Bottom Rail",
              "Post",
              "Picket",
              "Other"
            ]
          },
          "material_id": {
            "type": "string",
            "description": "MaterialPriceList id"
          },
          "material_name": {
            "type": "string",
            "description": "Denormalized material name"
          },
          "label": {
            "type": "string",
            "description": "Other only: line label, e.g. Base plate"
          },
          "qty_per_unit": {
            "type": "number",
            "description": "Other only: quantity per job unit"
          },
          "fixed_qty": {
            "type": "number",
            "description": "Other only: fixed quantity added once"
          },
          "waste_pct": {
            "type": "number",
            "description": "Other only: waste as a fraction (0.1 = 10%)"
          }
        }
      }
    },
    "cost_primary_unit": {
      "type": "string",
      "description": "Display label for the primary pricing unit (e.g. 'Linear Foot', 'Riser', 'sqft')"
    },
    "cost_materials_per_unit": {
      "type": "number",
      "default": 0,
      "description": "Materials cost per primary unit ($/unit)"
    },
    "cost_fab_hours_per_unit": {
      "type": "number",
      "default": 0,
      "description": "Fabrication hours per primary unit"
    },
    "cost_powder_coat_per_unit": {
      "type": "number",
      "default": 0,
      "description": "Powder coat cost per primary unit ($/unit)"
    },
    "cost_install_crew_size": {
      "type": "number",
      "default": 0,
      "description": "Install crew size (number of people)"
    },
    "cost_install_hours_per_unit": {
      "type": "number",
      "default": 0,
      "description": "Install hours per primary unit (per crew member)"
    },
    "cost_markup_multiplier": {
      "type": "number",
      "default": 1.5,
      "description": "Markup multiplier applied to hard cost (e.g. 1.5 = 50% markup)"
    }
  },
  "required": [
    "name",
    "organization_id"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}