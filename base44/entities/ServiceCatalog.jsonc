{
  "name": "ServiceCatalog",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization ID for multi-tenant isolation"
    },
    "name": {
      "type": "string",
      "description": "Service name"
    },
    "category": {
      "type": "string",
      "description": "Category \u2014 can be custom (not limited to enum)"
    },
    "unit": {
      "type": "string",
      "default": "ls"
    },
    "default_unit_price": {
      "type": "number",
      "default": 0,
      "description": "Legacy default price \u2014 kept for backward compat; cost model is the new source of truth"
    },
    "default_description": {
      "type": "string",
      "description": "Default line item description shown on invoice"
    },
    "photo_url": {
      "type": "string",
      "description": "URL of the uploaded photo for this service item"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_railing": {
      "type": "boolean",
      "default": false,
      "description": "If true, volume discount tiers are applied based on lnft quantity"
    },
    "style_id": {
      "type": "string",
      "description": "Railing styles only (is_railing: true). Reference to the RailingStyleLibrary record this catalog item corresponds to. Drives style resolution in the estimate wizard."
    },
    "post_spacing_in": {
      "type": "number",
      "default": 72,
      "description": "Railing takeoff parameter: spacing between posts in inches."
    },
    "post_width_in": {
      "type": "number",
      "default": 1.5,
      "description": "Railing takeoff parameter: post width in inches."
    },
    "picket_clear_gap_in": {
      "type": "number",
      "default": 4,
      "description": "Railing takeoff parameter: clear gap between pickets in inches (code-compliant max is typically 4)."
    },
    "picket_width_in": {
      "type": "number",
      "default": 0.5,
      "description": "Railing takeoff parameter: individual picket width in inches."
    },
    "rail_runs": {
      "type": "number",
      "default": 2,
      "description": "Railing takeoff parameter: number of horizontal rail runs (top + bottom rails). Integer."
    },
    "cost_primary_unit": {
      "type": "string",
      "description": "Display label for the primary pricing unit (e.g. 'Linear Foot', 'Riser', 'sqft')"
    },
    "cost_materials_per_unit": {
      "type": "number",
      "default": 0,
      "description": "Materials cost per primary unit ($/unit)"
    },
    "cost_fab_hours_per_unit": {
      "type": "number",
      "default": 0,
      "description": "Fabrication hours per primary unit"
    },
    "cost_powder_coat_per_unit": {
      "type": "number",
      "default": 0,
      "description": "Powder coat cost per primary unit ($/unit)"
    },
    "cost_install_crew_size": {
      "type": "number",
      "default": 0,
      "description": "Install crew size (number of people)"
    },
    "cost_install_hours_per_unit": {
      "type": "number",
      "default": 0,
      "description": "Install hours per primary unit (per crew member)"
    },
    "cost_markup_multiplier": {
      "type": "number",
      "default": 1.5,
      "description": "Markup multiplier applied to hard cost (e.g. 1.5 = 50% markup)"
    }
  },
  "required": [
    "name",
    "organization_id"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}