{
  "name": "LeadCloseReason",
  "type": "object",
  "properties": {
    "outcome_category": {
      "type": "string",
      "description": "The outcome category this reason belongs to, or the custom outcome name when is_custom_outcome is true"
    },
    "reason_label": {
      "type": "string",
      "description": "Display label for this reason (same as outcome_category when is_custom_outcome is true)"
    },
    "is_custom_outcome": {
      "type": "boolean",
      "default": false,
      "description": "If true, this record represents a custom outcome category rather than a reason within a standard category"
    },
    "created_by_id": {
      "type": "string",
      "description": "User ID of the creator"
    },
    "created_by_name": {
      "type": "string",
      "description": "Name of the creator"
    },
    "created_by_org_name": {
      "type": "string",
      "description": "Org name of the creator (for visibility/tracking)"
    }
  },
  "required": [
    "outcome_category",
    "reason_label"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {}
  }
}