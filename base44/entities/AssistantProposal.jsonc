{
  "name": "AssistantProposal",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization ID for multi-tenant isolation"
    },
    "conversation_id": {
      "type": "string",
      "description": "Assistant conversation this proposal belongs to"
    },
    "proposal_type": {
      "type": "string",
      "enum": [
        "job_update",
        "job_note",
        "estimate"
      ],
      "default": "job_update",
      "description": "What confirming this proposal will do"
    },
    "job_id": {
      "type": "string"
    },
    "job_number": {
      "type": "string"
    },
    "job_name": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Short headline shown on the review card"
    },
    "notes": {
      "type": "string",
      "description": "Plain-language explanation of what will happen when confirmed"
    },
    "changes": {
      "type": "array",
      "description": "Field edits for a job_update proposal",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Job field key"
          },
          "label": {
            "type": "string",
            "description": "Human-readable field name"
          },
          "old_value": {
            "type": "string",
            "description": "Current value as display text"
          },
          "new_value": {
            "type": "string",
            "description": "Proposed value as display text"
          }
        }
      }
    },
    "payload": {
      "type": "object",
      "description": "Type-specific data: job_note text, or estimate line items and totals"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "applied",
        "dismissed",
        "failed"
      ],
      "default": "pending",
      "enumColors": [
        "yellow",
        "green",
        "gray",
        "red"
      ],
      "description": "pending until the user confirms or dismisses it"
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    },
    "applied_by_id": {
      "type": "string"
    },
    "applied_by_name": {
      "type": "string"
    },
    "result_id": {
      "type": "string",
      "description": "Id of the created estimate, when one was created"
    },
    "error_message": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "proposal_type",
    "job_id"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}