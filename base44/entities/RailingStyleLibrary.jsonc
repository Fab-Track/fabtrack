{
  "name": "RailingStyleLibrary",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization ID for multi-tenant isolation"
    },
    "style_name": {
      "type": "string",
      "description": "Railing style name"
    },
    "photo_url": {
      "type": "string",
      "description": "Uploaded photo URL"
    },
    "description": {
      "type": "string",
      "description": "Optional description"
    },
    "post_spacing_in": {
      "type": "number",
      "default": 72,
      "description": "Railing takeoff parameter: spacing between posts in inches."
    },
    "post_width_in": {
      "type": "number",
      "default": 1.5,
      "description": "Railing takeoff parameter: post width in inches."
    },
    "picket_clear_gap_in": {
      "type": "number",
      "default": 4,
      "description": "Railing takeoff parameter: clear gap between pickets in inches (code-compliant max is typically 4)."
    },
    "picket_width_in": {
      "type": "number",
      "default": 0.5,
      "description": "Railing takeoff parameter: individual picket width in inches."
    },
    "rail_runs": {
      "type": "number",
      "default": 2,
      "description": "Railing takeoff parameter: number of horizontal rail runs (top + bottom rails). Integer."
    }
  },
  "required": [
    "style_name",
    "organization_id"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}