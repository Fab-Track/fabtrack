{
  "name": "DocumentTemplate",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization ID for multi-tenant isolation"
    },
    "category": {
      "type": "string",
      "enum": [
        "bid_request",
        "customer_order",
        "customer_invoice",
        "vendor_order",
        "vendor_bill"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "yellow",
        "gray"
      ],
      "description": "Document library group this template belongs to"
    },
    "name": {
      "type": "string",
      "description": "Template name shown in the library"
    },
    "body": {
      "type": "string",
      "description": "Template content with {{merge}} fields"
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "True for templates that shipped with FabTrack and can be reset to their default content"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "organization_id",
    "category",
    "name"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}