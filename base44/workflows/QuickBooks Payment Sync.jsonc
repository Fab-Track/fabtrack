{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "America/Denver",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "quickbooks_payment_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "poll_qbo_payments": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "qboPollPayments",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Check QuickBooks payments",
            "description": "Update invoice paid status"
          }
        }
      }
    ]
  },
  "name": "QuickBooks Payment Sync",
  "description": "Every 15 minutes, pulls new QuickBooks Online payments and updates the matching FabTrack invoices."
}