{
  "name": "Archive Job Channel on Paid/Closed",
  "description": "Archives the associated job channel when a job's billing stage becomes \"Paid / Closed\"",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"stage\") != null) and (.trigger.data.stage == \"Paid / Closed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Job"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "archive_job_channel_on_paid_closed",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "archiveJobChannelOnPaid",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "archiveJobChannelOnPaid"
  }
}