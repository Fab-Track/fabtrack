{
  "name": "Update Customer Status on Job Won",
  "description": "Updates customer_status, total_jobs_won, and won dates when a job's lead_outcome changes to Qualified \u2014 Won",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"lead_outcome\") != null) and (.trigger.data.lead_outcome == \"Qualified \\u2014 Won\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Job"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "update_customer_status_on_job_won",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "updateCustomerStatus",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "updateCustomerStatus"
  }
}