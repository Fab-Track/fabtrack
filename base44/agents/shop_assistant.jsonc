    {
      "function_name": "assistantProposal",
      "description": "Stage a proposed job field update, job note, or draft estimate for the user to review and confirm. Nothing is saved by this call."
    },
    {
      "function_name": "assistantKnowledge",
      "description": "Save, update or delete an organization-level company fact, pricing rule or process the assistant should recall later."
    },
    {
      "function_name": "assistantDataQuery",
      "description": "Read-only totals about this organization's shop data: outstanding and overdue invoice balances, estimates awaiting customer approval, and job counts by pipeline stage. Never changes records."
    }
  ],
  "name": "shop_assistant"
}